#include <stdio.h>
int graph[10][10];
int visited[10];
int n;

void bfs(int start)
{
    int queue[10];
    int front = 0, rear = 0;
    int i, current;

    queue[rear] = start;
    rear++;
    visited[start] = 1;

    while (front < rear)
    {
        current = queue[front];
        front++;

        printf("%d ", current);

        for (i = 0; i < n; i++)
        {
            if (graph[current][i] == 1 && visited[i] == 0)
            {
                queue[rear] = i;
                rear++;
                visited[i] = 1;
            }
        }
    }
}

int main()
{
    int i, j, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
        }
    }

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    printf("BFS Traversal: ");
    bfs(start);

    return 0;
}
